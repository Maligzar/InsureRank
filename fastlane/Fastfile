default_platform(:ios)

platform :ios do
  # Sync code signing certificates + profiles from the match private repo
  before_all do
    setup_ci if is_ci
    match(
      type: "appstore",
      app_identifier: "com.insurerank.app",
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      readonly: is_ci,
    )
  end

  desc "Build and upload a new TestFlight beta"
  lane :ios_beta do
    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s,
      xcodeproj: "ios/App/App.xcodeproj",
    )
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.insurerank.app" => "match AppStore com.insurerank.app",
        },
      },
    )
    upload_to_testflight(
      api_key_path: "fastlane/api_key.json",
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Promote the latest TestFlight build to App Store"
  lane :ios_release do
    upload_to_app_store(
      api_key_path: "fastlane/api_key.json",
      submit_for_review: true,
      automatic_release: false,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false,
      },
    )
  end
end
