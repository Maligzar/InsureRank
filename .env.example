# ─── Database (Cloud SQL via Auth Proxy for local dev) ────────────────────────
# Local: run `cloud-sql-proxy insurerank-prod:us-central1:insurerank-pg`
# then use: postgresql://postgres:password@127.0.0.1:5432/insurerank
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/insurerank?schema=public"
DIRECT_URL="postgresql://postgres:password@127.0.0.1:5432/insurerank?schema=public"

# ─── Redis (Memorystore via tunnel for local dev) ─────────────────────────────
# Local: run `gcloud compute ssh ... --tunnel-through-iap -- -L 6379:REDIS_IP:6379`
REDIS_URL="redis://127.0.0.1:6379"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-32-char-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google Cloud Storage ─────────────────────────────────────────────────────
GCS_BUCKET_NAME="insurerank-documents"
# Path to local service account JSON (dev only; in prod injected via Secret Manager)
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# ─── Firebase (FCM push notifications) ───────────────────────────────────────
FIREBASE_PROJECT_ID="insurerank-prod"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@insurerank-prod.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"

# ─── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_replace_with_key"
RESEND_FROM_EMAIL="noreply@insurerank.com"

# ─── Twilio (voice + SMS) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace-with-auth-token"
TWILIO_PHONE_NUMBER="+15550000000"
# API Key + Secret for Access Tokens (create at console.twilio.com/project/api-keys)
TWILIO_API_KEY="SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_API_SECRET="replace-with-api-secret"
# TwiML App SID (create at console.twilio.com/voice/twiml/apps)
# Set Voice Request URL to: https://your-domain.com/api/v1/twilio/voice/outbound
TWILIO_APP_SID="APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Expose local webhook with: npx ngrok http 3000
TWILIO_WEBHOOK_BASE_URL="https://your-ngrok-url.ngrok.io"

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN="https://replace@sentry.io/project"
NEXT_PUBLIC_SENTRY_DSN="https://replace@sentry.io/project"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="insurerank"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
# Disable service worker in local dev to avoid stale cache issues
DISABLE_SW="true"

# ─── Capacitor (iOS) ──────────────────────────────────────────────────────────
# URL the WKWebView loads in production builds (set to prod domain)
CAPACITOR_SERVER_URL="https://app.insurerank.com"
